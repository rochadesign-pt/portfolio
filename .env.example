# Google Analytics 4 — set to your Measurement ID to activate GA4.
# Leave empty to keep GA4 off (Vercel Analytics still works on its own).
# In Vercel: Project → Settings → Environment Variables → VITE_GA_ID
VITE_GA_ID=

# Sanity — content source. Set the project id to pull content from Sanity;
# leave empty to use the bundled local data.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Contact form — deliver submissions to the studio inbox, with captcha.
# Set these in Vercel → Settings → Environment Variables, then redeploy.
#
# Web3Forms access key — free, instant at https://web3forms.com (enter the
# inbox you want submissions delivered to). Public/safe to ship; spam is
# stopped by the captcha + honeypot.
VITE_WEB3FORMS_KEY=
#
# Cloudflare Turnstile SITE key (public) — free widget at
# https://dash.cloudflare.com → Turnstile. Paste the matching Turnstile SECRET
# key into the Web3Forms dashboard so it can verify the captcha server-side.
VITE_TURNSTILE_SITE_KEY=
